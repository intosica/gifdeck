[Application]
name=dev.gifdeck.GifDeck
runtime=org.gnome.Platform/x86_64/50
sdk=org.gnome.Sdk/x86_64/50
command=gifdeck

[Context]
shared=ipc;
sockets=fallback-x11;wayland;
devices=dri;

[Extension dev.gifdeck.GifDeck.Debug]
directory=lib/debug
autodelete=true
no-autodownload=true

[Build]
built-extensions=dev.gifdeck.GifDeck.Debug;